# Copy this file to `.env` and fill in your key(s). `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#   # then edit .env and paste your key
#
# API-Football (api-sports.io) — free tier ~100 req/day. Used by the SP2 enrichment
# layer for confirmed lineups + coaches. Get a free key at https://www.api-football.com/
API_FOOTBALL_KEY=

# Kalshi is NOT required for the read-only monitor (market-data endpoints are public).
# Only needed later for the deferred auto-execution phase.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
